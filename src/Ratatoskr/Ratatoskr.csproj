<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>A lightweight CloudEvents bus implementation.</Description>
        <PackageTags>cloudevents;eventbus;messaging</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="MinVer">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ratatoskr.Tests" />
        <InternalsVisibleTo Include="Ratatoskr.RabbitMq" />
        <InternalsVisibleTo Include="Ratatoskr.EfCore" />
        <InternalsVisibleTo Include="Ratatoskr.Testing" />
    </ItemGroup>
</Project>
