<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Embedded multi-transport management dashboard for Ratatoskr CloudEventBus.</Description>
    <PackageTags>cloudevents;eventbus;ui;dashboard;management;ratatoskr</PackageTags>
    <IsPackable>true</IsPackable>
    <!--
      VSTHRD103 flags DbSet.Add and JsonSerializer.Serialize as "synchronously blocking" because
      an *Async overload exists. Neither blocks: AddAsync only differs for value generators that
      need a database round-trip, and the serializer overload is for streams.
    -->
    <NoWarn>$(NoWarn);1591;CA1848;CA1873;VSTHRD103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Design-time only: generating the shipped migrations needs a provider to model against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratatoskr\Ratatoskr.csproj" />
    <ProjectReference Include="..\Ratatoskr.Management.Abstractions\Ratatoskr.Management.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ratatoskr.Tests" />
  </ItemGroup>
</Project>
