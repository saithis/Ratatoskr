<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Transport-neutral management control plane for Ratatoskr CloudEventBus.</Description>
    <PackageTags>cloudevents;eventbus;management;ratatoskr</PackageTags>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);1591;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratatoskr\Ratatoskr.csproj" />
    <ProjectReference Include="..\Ratatoskr.Management.Abstractions\Ratatoskr.Management.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ratatoskr.Management.EfCore" />
    <InternalsVisibleTo Include="Ratatoskr.Management.RabbitMq" />
    <InternalsVisibleTo Include="Ratatoskr.UI" />
    <InternalsVisibleTo Include="Ratatoskr.Tests" />
  </ItemGroup>
</Project>
