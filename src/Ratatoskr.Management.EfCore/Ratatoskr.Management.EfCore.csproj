<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EF Core inbox and outbox management operations and REST API for Ratatoskr.</Description>
    <PackageTags>cloudevents;eventbus;management;efcore;ratatoskr</PackageTags>
    <IsPackable>true</IsPackable>
    <!--
      IDISP001: every DbContext in this package is resolved from the dispatcher's per-execution
      scope and disposed with it. The analyzer cannot see that ownership, and suppressing it at
      each of the dozen call sites would be noisier than stating it once here.
    -->
    <NoWarn>$(NoWarn);1591;CA1848;CA1873;IDISP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratatoskr.EfCore\Ratatoskr.EfCore.csproj" />
    <ProjectReference Include="..\Ratatoskr.Management\Ratatoskr.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ratatoskr.Tests" />
  </ItemGroup>
</Project>
