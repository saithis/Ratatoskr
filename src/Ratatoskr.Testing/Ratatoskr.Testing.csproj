    <PackageTags>cloudevents;eventbus;messaging;testing</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratatoskr\Ratatoskr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ratatoskr.Tests" />
  </ItemGroup>
</Project>
