<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Authors>Saithis</Authors>
    <PackageProjectUrl>https://github.com/saithis/Ratatoskr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/saithis/Ratatoskr</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)images/icon.png" Pack="true" PackagePath="\" Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildThisFileDirectory)images/icon.png')" />
  </ItemGroup>
</Project>
