[*.cs]

# CS1591: Missing XML comment for publicly visible type or member
dotnet_diagnostic.CS1591.severity = none

# ASYNC0001: Append asynchronous method name with Async
dotnet_diagnostic.ASYNC0001.severity = none

# CA1707: Remove the underscores from member name
dotnet_diagnostic.CA1707.severity = none

# VSTHRD200: Use "Async" suffix in names of methods that return an awaitable type
dotnet_diagnostic.VSTHRD200.severity = none

# RCS1046: Add suffix 'Async' to asynchronous method name
dotnet_diagnostic.RCS1046.severity = none

# Do not expose generic lists
dotnet_diagnostic.CA1002.severity = none

# Review SQL queries for security vulnerabilities
dotnet_diagnostic.CA2100.severity = none

# Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = none

# Seal internal types
dotnet_diagnostic.CA1852.severity = none

# Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1711.severity = none

# Use an overload with a CancellationToken
dotnet_diagnostic.MA0040.severity = suggestion

# Pass System.Uri objects instead of strings
dotnet_diagnostic.CA2234.severity = none

# RCS1163: Unused parameters (very common in lambdas, DI factory mock registrations 'sp => ...')
dotnet_diagnostic.RCS1163.severity = none

# RCS1118: Mark local variable as const (not needed in test logic)
dotnet_diagnostic.RCS1118.severity = none

# MA0016: Use a collection abstraction instead of concrete type (tests can use concrete collections directly)
dotnet_diagnostic.MA0016.severity = none

# CS8602/CS8625: Nullability dereferences / passing null (standard in negative tests)
dotnet_diagnostic.CS8602.severity = none
dotnet_diagnostic.CS8625.severity = none

# EF1002: EF Core SQL injection check (we test raw SQL behavior directly)
dotnet_diagnostic.EF1002.severity = none

# CA1056: URI properties should not be strings (standard mock variables)
dotnet_diagnostic.CA1056.severity = none

# MA0051: Method is too long (methods in test projects are naturally long sequences of setup/assertions)
dotnet_diagnostic.MA0051.severity = none
